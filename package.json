{
  "name": "review-surface",
  "displayName": "Review Surface",
  "description": "Unified live review of Git changes in the working editor, read-only by default.",
  "version": "0.3.1",
  "publisher": "collinviz",
  "repository": {
    "type": "git",
    "url": "https://github.com/CollinViz/vscode-extention-not-diff.git"
  },
  "homepage": "https://github.com/CollinViz/vscode-extention-not-diff#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CollinViz/vscode-extention-not-diff/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "SCM"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:review-surface.changes",
    "onStartupFinished",
    "onCommand:review-surface.refresh",
    "onCommand:review-surface.toggleViewMode",
    "onCommand:review-surface.showFlatView",
    "onCommand:review-surface.showTreeView",
    "onCommand:review-surface.setScopeLastN",
    "onCommand:review-surface.setScopeDateRange",
    "onCommand:review-surface.openFile",
    "onCommand:review-surface.openDiffVsBase",
    "onCommand:review-surface.toggleEditMode",
    "onCommand:review-surface.enableEditMode",
    "onCommand:review-surface.enableReadOnly",
    "onCommand:review-surface.nextChange",
    "onCommand:review-surface.previousChange",
    "onCommand:review-surface.toggleReviewed",
    "onCommand:review-surface.markAllReviewed",
    "onCommand:review-surface.clearReviewed",
    "onCommand:review-surface.toggleFocusMode",
    "onCommand:review-surface.enableFocusMode",
    "onCommand:review-surface.disableFocusMode"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "compile:tests": "tsc -p tsconfig.integration.json",
    "lint": "eslint .",
    "build": "node esbuild.mjs",
    "test:unit": "vitest run",
    "test:integration": "npm run build && npm run compile:tests && node ./out-test/test/integration/runTest.js",
    "check": "npm run compile && npm run lint && npm run build && npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.18.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "globals": "^17.14.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "review-surface",
          "title": "Review Surface",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "review-surface": [
        {
          "id": "review-surface.changes",
          "name": "Changed Files",
          "contextualTitle": "Review Surface"
        }
      ]
    },
    "commands": [
      {
        "command": "review-surface.refresh",
        "title": "Refresh Review Surface",
        "category": "Review Surface",
        "icon": "$(refresh)"
      },
      {
        "command": "review-surface.toggleViewMode",
        "title": "Toggle Tree / Flat List",
        "category": "Review Surface"
      },
      {
        "command": "review-surface.showFlatView",
        "title": "Show Flat List",
        "category": "Review Surface",
        "icon": "$(list-flat)"
      },
      {
        "command": "review-surface.showTreeView",
        "title": "Show Tree",
        "category": "Review Surface",
        "icon": "$(list-tree)"
      },
      {
        "command": "review-surface.setScopeLastN",
        "title": "Set Scope: Last N Commits",
        "category": "Review Surface",
        "icon": "$(history)"
      },
      {
        "command": "review-surface.setScopeDateRange",
        "title": "Set Scope",
        "category": "Review Surface",
        "icon": "$(filter)"
      },
      {
        "command": "review-surface.openFile",
        "title": "Open File in Review Surface",
        "category": "Review Surface"
      },
      {
        "command": "review-surface.openDiffVsBase",
        "title": "Open Diff vs Base",
        "category": "Review Surface",
        "icon": "$(diff)"
      },
      {
        "command": "review-surface.toggleEditMode",
        "title": "Toggle Review Edit Mode",
        "category": "Review Surface"
      },
      {
        "command": "review-surface.enableEditMode",
        "title": "Switch to Editing",
        "category": "Review Surface",
        "icon": "$(unlock)"
      },
      {
        "command": "review-surface.enableReadOnly",
        "title": "Switch to Read-Only",
        "category": "Review Surface",
        "icon": "$(lock)"
      },
      {
        "command": "review-surface.nextChange",
        "title": "Review: Go to Next Change",
        "category": "Review Surface",
        "icon": "$(arrow-down)"
      },
      {
        "command": "review-surface.previousChange",
        "title": "Review: Go to Previous Change",
        "category": "Review Surface",
        "icon": "$(arrow-up)"
      },
      {
        "command": "review-surface.toggleReviewed",
        "title": "Review: Toggle Reviewed (this session)",
        "category": "Review Surface",
        "icon": "$(check)"
      },
      {
        "command": "review-surface.markAllReviewed",
        "title": "Review: Mark All Reviewed (this session)",
        "category": "Review Surface",
        "icon": "$(check-all)"
      },
      {
        "command": "review-surface.clearReviewed",
        "title": "Review: Clear Reviewed State",
        "category": "Review Surface",
        "icon": "$(clear-all)"
      },
      {
        "command": "review-surface.toggleFocusMode",
        "title": "Review: Toggle Focus Mode (hide unmodified lines)",
        "category": "Review Surface"
      },
      {
        "command": "review-surface.enableFocusMode",
        "title": "Review: Focus Changed Lines",
        "category": "Review Surface",
        "icon": "$(fold-down)"
      },
      {
        "command": "review-surface.disableFocusMode",
        "title": "Review: Show Full File",
        "category": "Review Surface",
        "icon": "$(unfold)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "review-surface.showFlatView",
          "when": "view == review-surface.changes && reviewSurface.viewIsTree",
          "group": "navigation@1"
        },
        {
          "command": "review-surface.showTreeView",
          "when": "view == review-surface.changes && !reviewSurface.viewIsTree",
          "group": "navigation@1"
        },
        {
          "command": "review-surface.setScopeLastN",
          "when": "view == review-surface.changes",
          "group": "navigation@2"
        },
        {
          "command": "review-surface.setScopeDateRange",
          "when": "view == review-surface.changes",
          "group": "navigation@3"
        },
        {
          "command": "review-surface.refresh",
          "when": "view == review-surface.changes",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "review-surface.enableEditMode",
          "when": "reviewSurface.isReviewFile && reviewSurface.isReadOnly",
          "group": "navigation@1"
        },
        {
          "command": "review-surface.enableReadOnly",
          "when": "reviewSurface.isReviewFile && !reviewSurface.isReadOnly",
          "group": "navigation@1"
        },
        {
          "command": "review-surface.openDiffVsBase",
          "when": "reviewSurface.isReviewFile",
          "group": "navigation@2"
        },
        {
          "command": "review-surface.nextChange",
          "when": "reviewSurface.isReviewFile",
          "group": "navigation@3"
        },
        {
          "command": "review-surface.enableFocusMode",
          "when": "reviewSurface.isReviewFile && !reviewSurface.focusMode",
          "group": "navigation@4"
        },
        {
          "command": "review-surface.disableFocusMode",
          "when": "reviewSurface.isReviewFile && reviewSurface.focusMode",
          "group": "navigation@4"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "review-surface.openDiffVsBase",
          "when": "reviewSurface.isReviewFile",
          "group": "review@1"
        }
      ],
      "view/item/context": [
        {
          "command": "review-surface.toggleReviewed",
          "when": "view == review-surface.changes && viewItem =~ /^reviewSurface\\.file/",
          "group": "review@1"
        }
      ],
      "commandPalette": [
        {
          "command": "review-surface.openFile",
          "when": "false"
        },
        {
          "command": "review-surface.showFlatView",
          "when": "false"
        },
        {
          "command": "review-surface.showTreeView",
          "when": "false"
        },
        {
          "command": "review-surface.enableEditMode",
          "when": "false"
        },
        {
          "command": "review-surface.enableReadOnly",
          "when": "false"
        },
        {
          "command": "review-surface.toggleReviewed",
          "when": "reviewSurface.isReviewFile"
        },
        {
          "command": "review-surface.enableFocusMode",
          "when": "false"
        },
        {
          "command": "review-surface.disableFocusMode",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "review-surface.toggleEditMode",
        "key": "alt+r",
        "mac": "alt+r",
        "when": "editorTextFocus && reviewSurface.isReviewFile"
      },
      {
        "command": "review-surface.openDiffVsBase",
        "key": "alt+d",
        "mac": "alt+d",
        "when": "editorTextFocus && reviewSurface.isReviewFile"
      },
      {
        "command": "review-surface.nextChange",
        "key": "f7",
        "mac": "f7",
        "when": "editorTextFocus && reviewSurface.isReviewFile"
      },
      {
        "command": "review-surface.previousChange",
        "key": "shift+f7",
        "mac": "shift+f7",
        "when": "editorTextFocus && reviewSurface.isReviewFile"
      }
    ],
    "configuration": {
      "title": "Review Surface",
      "properties": {
        "reviewSurface.defaultCommitCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Default N offered by the Last-N scope picker (DEFAULT_COMMIT_COUNT = 10)."
        },
        "reviewSurface.debounceRefreshMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "description": "Debounce delay in ms for live-sync refresh (DEBOUNCE_REFRESH_MS)."
        },
        "reviewSurface.focusContextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Unmodified lines kept visible above and below each change in Focus Mode (DEFAULT_FOCUS_CONTEXT_LINES = 3)."
        }
      }
    }
  }
}
